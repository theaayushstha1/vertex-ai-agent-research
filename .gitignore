# Google AI Engine Research - Git Ignore
# ======================================

# =============================================================================
# SECURITY - Never commit these!
# =============================================================================

# Environment variables (contains secrets)
.env
.env.local
.env.*.local

# OAuth credentials and tokens
credentials/
*.json

# Service account keys
*-service-account.json
*-credentials.json

# =============================================================================
# Python
# =============================================================================

# Byte-compiled files
__pycache__/
*.py[cod]
*$py.class

# Virtual environments
.venv/
venv/
env/
ENV/

# Distribution / packaging
dist/
build/
*.egg-info/
*.egg

# PyInstaller
*.manifest
*.spec

# Installer logs
pip-log.txt
pip-delete-this-directory.txt

# pytest
.pytest_cache/
.coverage
htmlcov/

# mypy
.mypy_cache/

# Ruff
.ruff_cache/

# =============================================================================
# IDE / Editors
# =============================================================================

# VS Code
.vscode/
*.code-workspace

# PyCharm
.idea/

# Vim
*.swp
*.swo

# =============================================================================
# OS Files
# =============================================================================

# macOS
.DS_Store
.AppleDouble
.LSOverride

# Windows
Thumbs.db
ehthumbs.db
Desktop.ini

# Linux
*~

# =============================================================================
# Project Specific
# =============================================================================

# Logs
*.log
logs/

# Temporary files
tmp/
temp/
nul

# Data files (if large)
data/*.csv
data/*.parquet

# But keep the structure
!data/.gitkeep
!credentials/.gitkeep

# Claude Code
.claude/

# Playwright MCP
.playwright-mcp/

# ADK temp deploy folders
adk_deploy/*_tmp*/

# Session files
SESSION_HANDOFF.md
CONTINUE_PROMPT.txt
*.db
.adk/

# Local docs (not for repo)
HOW_TO_RUN.md
