# =============================================================================
# Vertex AI Agent Research - Environment Configuration
# =============================================================================
# Copy this file to .env and fill in your values
# DO NOT commit .env to version control!

# =============================================================================
# REQUIRED: Google Cloud Settings
# =============================================================================
# Your Google Cloud Project ID
# Find at: https://console.cloud.google.com (top bar)
GOOGLE_CLOUD_PROJECT=your-project-id

# Google Cloud region for Vertex AI
GOOGLE_CLOUD_LOCATION=us-central1

# =============================================================================
# REQUIRED: Vertex AI Knowledge Base (Data Store)
# =============================================================================
# Your Vertex AI Search Data Store ID
# Format: projects/PROJECT_ID/locations/LOCATION/collections/default_collection/dataStores/DATASTORE_ID
# Create at: https://console.cloud.google.com/vertex-ai/search
VERTEX_AI_DATASTORE_ID=projects/your-project/locations/us/collections/default_collection/dataStores/your-datastore-id

# =============================================================================
# OPTIONAL: Model Settings
# =============================================================================
# Which Gemini model to use
# Options: gemini-2.5-flash (fast), gemini-2.5-pro (powerful)
VERTEX_AI_MODEL=gemini-2.5-flash

# =============================================================================
# OPTIONAL: Agent Settings
# =============================================================================
# Maximum agents to run in parallel (1-10)
MAX_PARALLEL_AGENTS=4

# Timeout for each agent response in seconds (5-120)
AGENT_TIMEOUT_SECONDS=30

# =============================================================================
# OPTIONAL: MCP Settings (Gmail/Calendar integration)
# =============================================================================
MCP_GMAIL_ENABLED=false
MCP_CALENDAR_ENABLED=false

# =============================================================================
# OPTIONAL: Logging
# =============================================================================
# Logging level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO
